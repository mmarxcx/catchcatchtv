# ============================================================
# CatchCatchTV v3 — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.
# ============================================================

# Flask secret key — change this to a long random string in production
SECRET_KEY=CHANGE-THIS-TO-A-LONG-RANDOM-STRING

# PostgreSQL connection string
# Local default (matches db_setup.sql):
DATABASE_URL=postgresql://camuser:campass123@localhost:5432/catchcatchtv
# Railway provides this automatically when you add a PostgreSQL plugin.

# Flask environment — set to "production" on Railway/Render
FLASK_ENV=development

# Session inactivity timeout in seconds (default: 1800 = 30 minutes)
SESSION_INACTIVITY=1800

# Max concurrent streams per user
MAX_ACTIVE_STREAMS=2

# Admin email — this user will be auto-promoted to admin on startup
# ADMIN_EMAIL=your@email.com

# Brevo (Sendinblue) API key — used for password-reset emails
# Get your key at: https://app.brevo.com/settings/keys/api
# BREVO_API_KEY=xkeysib-...

# Discord webhook for system alerts (optional)
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/...

# AbuseIPDB API key for server-side admin IP reputation lookups (optional)
# ABUSEIPDB_API_KEY=...

# Flask-Mail settings (optional — password reset emails)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=your@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_DEFAULT_SENDER=your@gmail.com
